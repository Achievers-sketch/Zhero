# Copy to .env and fill in local values. Never commit real credentials.
# Placeholders and starting values only, not verified optimal settings.

# Backend
APP_ENV=development
APP_SECRET_KEY=replace_with_local_secret
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/zhero

# LLM provider adapter (not used yet)
LLM_PROVIDER=mock
LLM_MODEL=replace_with_selected_model
LLM_API_KEY=

# Embeddings (not used yet)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=replace_with_selected_embedding_model

# File handling (not used yet)
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# Vector search / RAG (not used yet)
RAG_TOP_K=5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
